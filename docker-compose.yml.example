services:
  mysql:
    image: mysql:8.0
    container_name: paysplit-mysql
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: YOUR_MYSQL_PASSWORD_HERE
      MYSQL_DATABASE: paysplit_db
    ports:
      - "3307:3306"
    volumes:
      - paysplit_mysql_data:/var/lib/mysql

  backend:
    build: ./backend
    container_name: paysplit-backend
    restart: always
    ports:
      - "8080:8080"
    depends_on:
      - mysql
    environment:
      SPRING_DATASOURCE_URL: jdbc:mysql://mysql:3306/paysplit_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
      SPRING_DATASOURCE_USERNAME: root
      SPRING_DATASOURCE_PASSWORD: YOUR_MYSQL_PASSWORD_HERE

volumes:
  paysplit_mysql_data: