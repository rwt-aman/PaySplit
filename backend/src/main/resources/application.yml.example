server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/paysplit_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    username: root
    password: YOUR_MYSQL_PASSWORD_HERE
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
        format_sql: true

jwt:
  secret: REPLACE_WITH_YOUR_OWN_LONG_RANDOM_SECRET_STRING
  expiration: 86400000